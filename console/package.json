{
  "name": "@maas/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "types": "node scripts/generate-types.mjs",
    "format:check": "prettier --check src scripts index.html package.json tsconfig.json vite.config.ts",
    "dev:fixtures": "vite --host 127.0.0.1 --mode fixtures",
    "test:review-browser": "node scripts/review-browser.mjs",
    "dev:go": "vite --host 127.0.0.1",
    "test:go-browser": "node scripts/go-browser.mjs",
    "test:release-browser": "node scripts/release-browser.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  }
}
