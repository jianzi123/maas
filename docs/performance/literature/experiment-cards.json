    {
      "id": "E-LIT-01",
      "title": "观测/空闲节奏能否重复触发图重放快慢状态",
      "source_ids": [
        "B03",
        "B06"
      ],
      "status": "design_only",
      "execution_enabled": false,
      "requires_implementation": true,
      "implementation_gap": "现bench_kv_interleaved每块前调用telemetry；尚无cadence开关，不编造可运行新CLI",
      "hypothesis": "nvidia-smi查询或查询造成的空闲节奏对已观察漂移有可重复贡献；不是已证明根因",
      "existing_evidence": {
        "code_commit": "7315b32",
        "path": "tools/perf/operators/local_gpu/evidence/window-b-v0.20/analysis.json",
        "facts": [
          "240交错块/120对，33对M更慢；独立控制另54块",
          "裸图仍有长事件/等待，host enqueue短",
          "nvidia-smi块前快照不是连续频率/其他工作控制"
        ]
      },
      "source_map_ids": [
        "S01",
        "S02",
        "S03",
        "S04"
      ],
      "freeze": [
        "同一进程/原生模型seed/dtype/输入/图DAG与指针",
        "相同capture顺序/轮次/调用数；native与mature分别分层"
      ],
      "single_factor": "telemetry/空闲策略；预先固定3水平：块前查询、cluster前查询、无查询但按预先记录查询时长匹配空闲；禁止按测后快慢挑参数",
      "workload_matrix": [
        {
          "batch": 3,
          "input_length": 12,
          "decode_length": 13,
          "captured_batch": 4
        },
        {
          "batch": 5,
          "input_length": 12,
          "decode_length": 13,
          "captured_batch": 8
        },
        {
          "batch": 8,
          "input_length": 12,
          "decode_length": 13,
          "captured_batch": 8
        }
      ],
      "design": "3个策略按预置轮转次序交错；每cluster10块×10调用，所有慢态/超时保留；仅策略级比较，不将重复块当独立样本",
      "measurements": [
        "event_with_host_gaps_us",
        "host_enqueue_us",
        "thread_CPU_us",
        "wait_us",
        "wall_sync_us",
        "实际空闲/查询时长",
        "区块/进程身份、超时、丢样覆盖",
        "固定图correlation/DAG另窗口核对"
      ],
      "numerical_gate": "沿原完整logits/30层实际写槽finite等价门禁；正确性与profile不进入热段",
      "falsification": [
        "反转策略后快慢变化不随策略重复，或效应小于同策略区块漂移，则不支持查询导致漂移",
        "查询与匹配空闲效果不同才进一步区分查询活动与空闲；仍不证明具体驱动机理"
      ],
      "stop_conditions": [
        "锁忙即退出，不排队抢其他GPU",
        "低于1GiB空闲/资源超限/600s/数值错误即停止，不产性能成功结论",
        "DAG或输入变化则该块仍保留但不能合入同条件效应"
      ],
      "read_only_reproduction": [
        "python",
        "tools/perf/operators/local_gpu/analyze_kv_window_b.py",
        "--input",
        "EXTRACTED_WINDOW_B_EVIDENCE",
        "--output",
        "NEW_ANALYSIS.json"
      ],
      "future_GPU_invocation": null,
      "resource_caps": {
        "gpu": 0,
        "research_lock": "/var/tmp/maas-10-gpu-01a1a5ba/gpu0-research.lock",
        "max_process_seconds": 600,
        "allocator_fraction": 0.2,
        "planner_fraction": 0.2,
        "max_requests": 8,
        "max_KV_tokens": 512,
        "max_context_length": 128,
        "min_free_bytes": 1073741824,
        "no_parallel_GPU": true,
        "no_weight_download": true,
        "default_split_cap": 8
      },
      "negative_or_unknown_outcome": "不支持假设也是交付；不得宣布WDDM/频率/CPU/驱动是根因或宣称成熟KV加速"
    },
