+++ b/plugins/wasm-go/extensions/ext-auth/maas_guard_test.go
@@ -0,0 +1,15 @@
+package main
+import "testing"
+func TestMaaSRequiredHeaders(t *testing.T){
+ good:=[][2]string{{"X-Request-ID","r"},{"X-Maas-Admission-Ticket","t"},{"X-Maas-Reservation-Plan","p"}}
+ if !maasRequiredHeaders(good){t.Fatal("valid header set rejected")}
+ for i:=range good {
+  missing:=append([][2]string{},good[:i]...);missing=append(missing,good[i+1:]...)
+  if maasRequiredHeaders(missing){t.Fatal("missing header accepted")}
+  empty:=append([][2]string{},good...);empty[i][1]=""
+  if maasRequiredHeaders(empty){t.Fatal("empty header accepted")}
+  duplicate:=append(append([][2]string{},good...),good[i])
+  if maasRequiredHeaders(duplicate){t.Fatal("duplicate accepted")}
+ }
+ if maasRequiredHeaders(nil){t.Fatal("empty list accepted")}
+}
