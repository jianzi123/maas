+++ b/plugins/wasm-go/extensions/ext-auth/maas_guard.go
@@ -0,0 +1,8 @@
+// Dedicated MaaS fork-local guard; does not verify or manufacture tickets.
+package main
+import "strings"
+func maasRequiredHeaders(headers [][2]string) bool {
+ counts:=map[string]int{}
+ for _,h:=range headers {name:=strings.ToLower(h[0]);if h[1]==""{counts[name]+=2}else{counts[name]++}}
+ return counts["x-request-id"]==1 && counts["x-maas-admission-ticket"]==1 && counts["x-maas-reservation-plan"]==1
+}
