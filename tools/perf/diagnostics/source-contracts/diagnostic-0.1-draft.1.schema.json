{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maas.example.invalid/schemas/internal/usage-receipt-diagnostic/0.1-draft.1",
  "title": "Internal diagnostic draft; never an accounting, closure or authorization receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1-draft.1"
    },
    "record_type": {
      "enum": [
        "receipt",
        "termination"
      ]
    },
    "diagnostic_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "owner_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "owner_fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invocation_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_release_uid": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "model_release_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "model_release_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "model_release_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "release_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "activation_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "route_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_purpose": {
          "type": "string",
          "enum": [
            "serving",
            "validation"
          ]
        },
        "price_snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_release_uid",
        "model_release_namespace",
        "model_release_name",
        "model_release_generation",
        "release_revision",
        "publication_id",
        "activation_epoch",
        "route_binding_sha256",
        "admission_purpose",
        "price_snapshot_id",
        "price_version"
      ]
    },
    "authority": {
      "const": "diagnostic_only"
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "input_cached_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasoning_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens",
            "input_cached_tokens",
            "reasoning_tokens"
          ],
          "anyOf": [
            {
              "properties": {
                "input_tokens": {
                  "type": "integer"
                }
              },
              "required": [
                "input_tokens"
              ]
            },
            {
              "properties": {
                "output_tokens": {
                  "type": "integer"
                }
              },
              "required": [
                "output_tokens"
              ]
            },
            {
              "properties": {
                "total_tokens": {
                  "type": "integer"
                }
              },
              "required": [
                "total_tokens"
              ]
            },
            {
              "properties": {
                "input_cached_tokens": {
                  "type": "integer"
                }
              },
              "required": [
                "input_cached_tokens"
              ]
            },
            {
              "properties": {
                "reasoning_tokens": {
                  "type": "integer"
                }
              },
              "required": [
                "reasoning_tokens"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cause": {
      "anyOf": [
        {
          "enum": [
            "eof",
            "client_write_error",
            "explicit_cancel",
            "deadline_exceeded",
            "parse_invalid",
            "usage_conflict",
            "diagnostic_limit",
            "normal_completion"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "diagnostic_id",
    "request_id",
    "owner_instance_id",
    "owner_fence",
    "sequence",
    "observed_at",
    "snapshot_sha256",
    "invocation_binding",
    "authority",
    "usage",
    "cause"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "receipt"
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "total_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "input_cached_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasoning_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "input_cached_tokens",
              "reasoning_tokens"
            ],
            "anyOf": [
              {
                "properties": {
                  "input_tokens": {
                    "type": "integer"
                  }
                },
                "required": [
                  "input_tokens"
                ]
              },
              {
                "properties": {
                  "output_tokens": {
                    "type": "integer"
                  }
                },
                "required": [
                  "output_tokens"
                ]
              },
              {
                "properties": {
                  "total_tokens": {
                    "type": "integer"
                  }
                },
                "required": [
                  "total_tokens"
                ]
              },
              {
                "properties": {
                  "input_cached_tokens": {
                    "type": "integer"
                  }
                },
                "required": [
                  "input_cached_tokens"
                ]
              },
              {
                "properties": {
                  "reasoning_tokens": {
                    "type": "integer"
                  }
                },
                "required": [
                  "reasoning_tokens"
                ]
              }
            ]
          },
          "cause": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "termination"
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "type": "null"
          },
          "cause": {
            "enum": [
              "eof",
              "client_write_error",
              "explicit_cancel",
              "deadline_exceeded",
              "parse_invalid",
              "usage_conflict",
              "diagnostic_limit",
              "normal_completion"
            ]
          }
        }
      }
    }
  ]
}
