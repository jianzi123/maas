{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "event_type": {
      "const": "request.finalized"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "key_id": {
      "type": "string",
      "format": "uuid"
    },
    "quota_date": {
      "type": "string",
      "format": "date"
    },
    "model_alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "upstream_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "config_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "admitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "interrupted"
      ]
    },
    "submission_state": {
      "type": "string",
      "enum": [
        "submitted",
        "not_submitted",
        "unknown"
      ]
    },
    "quota_consumed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_request",
            "model_not_found",
            "unsupported_field",
            "retention_window_exceeded",
            "payload_too_large",
            "invalid_api_key",
            "unauthenticated",
            "csrf_failed",
            "forbidden",
            "source_disabled",
            "not_found",
            "key_revoked",
            "state_conflict",
            "concurrency_exceeded",
            "login_rate_limited",
            "upstream_error",
            "upstream_protocol_error",
            "upstream_rate_limited",
            "upstream_timeout",
            "dependency_unavailable",
            "admission_busy",
            "route_not_ready",
            "accounting_unavailable",
            "shutting_down",
            "internal_error",
            "client_write_timeout",
            "client_cancelled",
            "owner_lost",
            "request_budget_exceeded",
            "token_budget_exceeded",
            "money_budget_exceeded",
            "rate_limited",
            "budget_bound_unavailable",
            "pricing_unavailable",
            "rate_limiter_unavailable",
            "policy_changed",
            "currency_mismatch",
            "budget_bound_breached",
            "release_not_callable",
            "release_revision_mismatch",
            "release_dependency_unavailable",
            "release_alias_conflict",
            "resource_version_conflict",
            "release_validation_pending"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "first_chunk_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "upstream",
            "unavailable"
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "not_provided",
                "partial",
                "cancelled_before_usage",
                "interrupted_before_usage"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "input_cached_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "source",
        "missing_reason",
        "input_cached_tokens",
        "reasoning_tokens"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "input_tokens": {
                "type": "null"
              },
              "output_tokens": {
                "type": "null"
              },
              "total_tokens": {
                "type": "null"
              },
              "missing_reason": {
                "type": "string",
                "enum": [
                  "not_provided",
                  "cancelled_before_usage",
                  "interrupted_before_usage"
                ]
              },
              "input_cached_tokens": {
                "type": "null"
              },
              "reasoning_tokens": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "upstream"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "input_tokens": {
                    "type": "integer"
                  }
                }
              },
              {
                "properties": {
                  "output_tokens": {
                    "type": "integer"
                  }
                }
              },
              {
                "properties": {
                  "total_tokens": {
                    "type": "integer"
                  }
                }
              },
              {
                "properties": {
                  "input_cached_tokens": {
                    "type": "integer"
                  }
                }
              },
              {
                "properties": {
                  "reasoning_tokens": {
                    "type": "integer"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "source": {
                  "const": "upstream"
                }
              }
            },
            "then": {
              "properties": {
                "missing_reason": {
                  "const": "partial"
                }
              }
            }
          }
        }
      ]
    },
    "metering_state": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "owner_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "not_submitted_evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "slot_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "allocation_fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "slot_id",
        "allocation_fence"
      ]
    },
    "reservation_plan": {
      "$ref": "#/$defs/ReservationPlan"
    },
    "budget_accounting": {
      "$ref": "#/$defs/BudgetAccounting"
    },
    "rate_witness": {
      "$ref": "#/$defs/RateWitness"
    },
    "invocation_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_release_uid": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "model_release_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "model_release_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "model_release_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "release_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "activation_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "route_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_purpose": {
          "type": "string",
          "enum": [
            "serving",
            "validation"
          ]
        },
        "price_snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_release_uid",
        "model_release_namespace",
        "model_release_name",
        "model_release_generation",
        "release_revision",
        "publication_id",
        "activation_epoch",
        "route_binding_sha256",
        "admission_purpose",
        "price_snapshot_id",
        "price_version"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "request_id",
    "key_id",
    "quota_date",
    "model_alias",
    "upstream_model",
    "source_id",
    "source_type",
    "config_revision",
    "received_at",
    "admitted_at",
    "observed_at",
    "result",
    "submission_state",
    "quota_consumed",
    "error_code",
    "duration_ms",
    "first_chunk_ms",
    "usage",
    "metering_state",
    "owner_instance_id",
    "owner_fence",
    "not_submitted_evidence_ref",
    "slot_binding",
    "reservation_plan",
    "budget_accounting",
    "rate_witness",
    "invocation_binding"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "submission_state": {
            "const": "not_submitted"
          }
        }
      },
      "then": {
        "properties": {
          "quota_consumed": {
            "const": 0
          },
          "not_submitted_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "quota_consumed": {
            "const": 1
          },
          "not_submitted_evidence_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "submission_state": {
            "const": "submitted"
          },
          "error_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error_code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "model_not_found",
              "unsupported_field",
              "retention_window_exceeded",
              "payload_too_large",
              "invalid_api_key",
              "unauthenticated",
              "csrf_failed",
              "forbidden",
              "source_disabled",
              "not_found",
              "key_revoked",
              "state_conflict",
              "concurrency_exceeded",
              "login_rate_limited",
              "upstream_error",
              "upstream_protocol_error",
              "upstream_rate_limited",
              "upstream_timeout",
              "dependency_unavailable",
              "admission_busy",
              "route_not_ready",
              "accounting_unavailable",
              "shutting_down",
              "internal_error",
              "client_write_timeout",
              "client_cancelled",
              "owner_lost",
              "request_budget_exceeded",
              "token_budget_exceeded",
              "money_budget_exceeded",
              "rate_limited",
              "budget_bound_unavailable",
              "pricing_unavailable",
              "rate_limiter_unavailable",
              "policy_changed",
              "currency_mismatch",
              "budget_bound_breached",
              "release_not_callable",
              "release_revision_mismatch",
              "release_dependency_unavailable",
              "release_alias_conflict",
              "resource_version_conflict",
              "release_validation_pending"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metering_state": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "failed",
              "cancelled",
              "timed_out",
              "interrupted"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maas.example.invalid/schemas/usage-event/3.0",
  "title": "MaaS terminal event 3.0 with immutable release binding",
  "description": "Sole Go terminal settlement into MySQL. Snapshot bindings, dimensional conservation, evidence authenticity, uniqueness and CAS are transactionally checked outside JSON Schema. Slot release is independent and never changes this accounting.",
  "$defs": {
    "AtomicInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$",
      "maxLength": 38
    },
    "MoneyLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "limit_atomic": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$",
          "maxLength": 38
        }
      },
      "required": [
        "currency",
        "limit_atomic"
      ]
    },
    "BudgetLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        },
        "money": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyLimit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requests",
        "tokens",
        "money"
      ]
    },
    "BudgetPolicyInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_kind": {
          "type": "string",
          "enum": [
            "utc_day",
            "utc_month"
          ]
        },
        "limits": {
          "$ref": "#/$defs/BudgetLimits"
        }
      },
      "required": [
        "window_kind",
        "limits"
      ]
    },
    "BudgetCounterVector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$",
          "maxLength": 38
        },
        "tokens": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,37})$",
          "maxLength": 38
        },
        "money_atomic": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requests",
        "tokens",
        "money_atomic"
      ]
    },
    "BudgetAvailableVector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        },
        "money_atomic": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requests",
        "tokens",
        "money_atomic"
      ]
    },
    "BudgetState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_kind": {
          "type": "string",
          "enum": [
            "utc_day",
            "utc_month"
          ]
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "admission_blocked": {
          "type": "boolean"
        },
        "block_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "budget_bound_breached",
                "release_not_callable",
                "release_revision_mismatch",
                "release_dependency_unavailable",
                "release_alias_conflict",
                "resource_version_conflict",
                "release_validation_pending"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_used": {
          "$ref": "#/$defs/BudgetCounterVector"
        },
        "inflight_reserved": {
          "$ref": "#/$defs/BudgetCounterVector"
        },
        "uncertainty_held": {
          "$ref": "#/$defs/BudgetCounterVector"
        },
        "available": {
          "$ref": "#/$defs/BudgetAvailableVector"
        }
      },
      "required": [
        "window_kind",
        "window_start",
        "window_end",
        "admission_blocked",
        "block_reason",
        "currency",
        "known_used",
        "inflight_reserved",
        "uncertainty_held",
        "available"
      ]
    },
    "ReservationPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "model_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "source_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "config_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "capability_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "budget_policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "window_kind": {
          "type": "string",
          "enum": [
            "utc_day",
            "utc_month"
          ]
        },
        "token_metric": {
          "const": "prompt_plus_completion"
        },
        "request_reserved": {
          "const": "1"
        },
        "input_upper_tokens": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
              "type": "null"
            }
          ]
        },
        "output_upper_tokens": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,37})$",
              "maxLength": 38
            },
            {
