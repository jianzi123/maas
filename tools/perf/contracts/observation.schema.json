{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maas.example.invalid/schemas/observation/1.0",
  "title": "Diagnostic observation envelope 1.0; no authorization or accounting authority",
  "$ref": "#/$defs/ObservationEnvelope",
  "$defs": {
    "ObservationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "observation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "request.observation",
            "release.reconcile",
            "workload.ready",
            "gateway.applied",
            "admission.enabled",
            "release.drain",
            "release.rollback",
            "release.cleanup"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "enum": [
            "go",
            "higress",
            "operator",
            "engine",
            "client"
          ]
        },
        "producer_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "actor_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "experiment_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gateway_observation_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvocationBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_metadata_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cr_uid": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "desired_generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "desired_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "admitted",
            "not_admitted",
            "not_applicable",
            "unknown"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "rejected",
            "cancelled",
            "pending",
            "unknown"
          ]
        },
        "clock_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server_first_chunk_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "client_visible_ttft_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "client_scheduled_ttft_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "model_native_ttft_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "client_e2e_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "tpot_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "chunk_gap_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "tpot_scope": {
              "type": "string",
              "enum": [
                "visible_proxy",
                "engine_generated",
                "not_applicable",
                "unavailable"
              ]
            },
            "token_sample_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "missing_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "server_first_chunk_ms",
                  "client_visible_ttft_ms",
                  "client_scheduled_ttft_ms",
                  "model_native_ttft_ms",
                  "client_e2e_ms",
                  "tpot_ms",
                  "chunk_gap_ms"
                ]
              }
            }
          },
          "required": [
            "server_first_chunk_ms",
            "client_visible_ttft_ms",
            "client_scheduled_ttft_ms",
            "model_native_ttft_ms",
            "client_e2e_ms",
            "tpot_ms",
            "chunk_gap_ms",
            "tpot_scope",
            "token_sample_count",
            "missing_fields"
          ]
        },
        "stages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "go.key_validate",
                  "go.bound_compute",
                  "go.flush",
                  "go.cancel",
                  "redis.pool_wait",
                  "redis.command_rtt",
                  "redis.script",
                  "mysql.pool_wait",
                  "mysql.lock",
                  "mysql.admission_commit",
                  "mysql.finalization_commit",
                  "higress.ext_auth",
                  "higress.connect",
                  "higress.upstream_first_byte",
                  "higress.transport_closed",
                  "engine.queue",
                  "engine.prefill",
                  "engine.decode",
                  "engine.abort",
                  "release.reconcile",
                  "release.workload_ready",
                  "release.gateway_applied",
                  "release.admission_enabled",
                  "release.drain",
                  "release.rollback",
                  "release.cleanup"
                ]
              },
              "duration_ms": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "measured",
                  "unavailable",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "name",
              "duration_ms",
              "provenance"
            ]
          }
        },
        "terminal_event_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "slot_release_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport_evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retention_policy_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "name",
            "revision"
          ]
        }
      },
      "required": [
        "schema_version",
        "observation_id",
        "event_type",
        "observed_at",
        "producer",
        "producer_revision",
        "actor_ref",
        "experiment_ref",
        "gateway_observation_ref",
        "request_id",
        "trace_id",
        "span_id",
        "parent_span_id",
        "invocation_binding",
        "runtime_metadata_ref",
        "cr_uid",
        "desired_generation",
        "observed_generation",
        "desired_revision",
        "active_revision",
        "resource_ref",
        "disposition",
        "outcome",
        "clock_scope",
        "timing",
        "stages",
        "terminal_event_ref",
        "slot_release_ref",
        "transport_evidence_ref",
        "sampling_fraction",
        "retention_policy_ref"
      ]
    },
    "InvocationBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_release_uid": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "model_release_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "model_release_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "model_release_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "release_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "activation_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "route_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_purpose": {
          "type": "string",
          "enum": [
            "serving",
            "validation"
          ]
        },
        "price_snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_release_uid",
        "model_release_namespace",
        "model_release_name",
        "model_release_generation",
        "release_revision",
        "publication_id",
        "activation_epoch",
        "route_binding_sha256",
        "admission_purpose",
        "price_snapshot_id",
        "price_version"
      ]
    },
    "RuntimeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "publication_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "string",
          "enum": [
            "observed",
            "unavailable",
            "not_applicable"
          ]
        },
        "weights_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenizer_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "chat_template_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine_image_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine_commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rank_mapping_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "publication_id",
        "runtime_instance_id",
        "observed_at",
        "state",
        "weights_sha256",
        "tokenizer_sha256",
        "chat_template_sha256",
        "engine_image_digest",
        "engine_commit",
        "effective_config_sha256",
        "profile_revision",
        "rank_mapping_ref"
      ]
    },
    "GatewayObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "publication_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "gateway_binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "gateway_instance_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "gateway_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "gateway_config_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "route_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "route_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "request_id",
        "publication_id",
        "gateway_binding_id",
        "gateway_instance_id",
        "gateway_epoch",
        "gateway_config_revision",
        "route_name",
        "route_binding_sha256"
      ]
    }
  }
}
