package kernel

// QA-owned tests compiled into internal/kernel through Go's -overlay option.
// setup supplies the author's disposable SQL fixture and synthetic approvals;
// assertions here are independent. H1-H4 and the HTTP gateway remain fixtures.
import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"
	"net/http/httptest"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/google/uuid"
)

func TestQABudgetRace(t *testing.T) {
	f := setup(t, 12)
	ctx := context.Background()
	p := Policy{Window: "utc_day", Revision: "qa-two-requests", Limits: Limits{Requests: ptr("2"), Tokens: ptr("14000"), Money: &MoneyLimit{Currency: "TST", Limit: "52000000"}}}
	if err := f.core.UpdatePolicy(ctx, f.key, p); err != nil {
		t.Fatal(err)
	}
	makeInput := func() Input {
		in := f.input(t)
		var err error
		in.Plan, err = BuildPlan(f.profile, p, "test-rate-v1")
		if err != nil {
			t.Fatal(err)
		}
		return in
	}
	mustAdmit(t, f, makeInput())
	other, err := New(f.db, "controlled-test", f.core.pepper, f.rate, f.proofs)
	if err != nil {
		t.Fatal(err)
	}
	inputs := make([]Input, 10)
	for i := range inputs {
		inputs[i] = makeInput()
	}
	var admitted atomic.Int64
	var wg sync.WaitGroup
	start := make(chan struct{})
	for i, in := range inputs {
		wg.Add(1)
		go func(i int, in Input) {
			defer wg.Done()
			<-start
			core := []*Store{f.core, other}[i%2]
			_, err := core.Admit(ctx, f.gate, in)
			if err == nil {
				admitted.Add(1)
			} else if !errors.Is(err, ErrBusy) && !errors.Is(err, ErrBudget) {
				t.Error(err)
			}
		}(i, in)
	}
	close(start)
	wg.Wait()
	if admitted.Load() > 1 {
		t.Fatalf("cross-replica over-admission: %d", admitted.Load())
	}
	// NOWAIT may reject every contender; check the still-available unit serially.
	if admitted.Load() == 0 {
		mustAdmit(t, f, makeInput())
	}
	if _, err := other.Admit(ctx, f.gate, makeInput()); !errors.Is(err, ErrBudget) {
		t.Fatalf("exhausted budget: %v", err)
	}
	assertSQL(t, f.db, "SELECT COUNT(*) FROM generation_requests", 2)
	t.Logf("sample=1 preadmission + 10 simultaneous attempts, two Store replicas; batch_success=%d", admitted.Load())
}

func TestQAConcurrentFinalAndSlotReuse(t *testing.T) {
	f := setup(t, 1)
	ctx := context.Background()
	s := mustAdmit(t, f, f.input(t))
	fin := finalFor(s)
	var wg sync.WaitGroup
	for i := 0; i < 10; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for attempt := 0; attempt < 100; attempt++ {
				err := f.core.Finalize(ctx, fin)
				if errors.Is(err, ErrBusy) {
					time.Sleep(time.Millisecond)
					continue
				}
				if err != nil {
					t.Error(err)
				}
				return
			}
			t.Error("terminal retry bound exhausted")
		}()
	}
	wg.Wait()
	before := readCounter(t, f, "tokens")
	if before.Held != "140" || before.Reserved != "0" {
		t.Fatal(before)
	}
	if err := f.core.Release(ctx, s.Input.RequestID, uuid.NewString(), uuid.NewString()); err != nil {
		t.Fatal(err)
	}
	next := mustAdmit(t, f, f.input(t))
	if err := f.core.Release(ctx, s.Input.RequestID, uuid.NewString(), uuid.NewString()); err != nil {
		t.Fatal(err)
	}
	assertSQL(t, f.db, "SELECT COUNT(*) FROM usage_events", 1)
	assertSQL(t, f.db, "SELECT SUM(finalized_total) FROM usage_daily", 1)
	assertSQL(t, f.db, "SELECT COUNT(*) FROM concurrency_slots WHERE request_id=? AND state='HELD'", 1, next.Input.RequestID)
	if got := readCounter(t, f, "tokens"); got.Held != before.Held {
		t.Fatal("late release refunded held", got)
	}
	t.Logf("original_request_id=%s next_request_id=%s", s.Input.RequestID, next.Input.RequestID)
}

func TestQATamperedBindingHasNoWrites(t *testing.T) {
	for _, field := range []string{"source", "publication", "reservation"} {
		t.Run(field, func(t *testing.T) {
			f := setup(t, 1)
			in := f.input(t)
			switch field {
			case "source":
				in.Profile.SourceID = uuid.NewString()
			case "publication":
				in.Profile.Binding.PublicationID = uuid.NewString()
			case "reservation":
				in.Plan.Tokens = ptr("0")
			}
			if _, err := f.core.Admit(context.Background(), f.gate, in); err == nil {
				t.Fatal("tampered binding admitted")
			}
			assertSQL(t, f.db, "SELECT COUNT(*) FROM generation_requests", 0)
			assertSQL(t, f.db, "SELECT COUNT(*) FROM budget_windows", 0)
			assertSQL(t, f.db, "SELECT COUNT(*) FROM rate_window_grants", 0)
		})
	}
}

func TestQAUsageBeforeTransportLoss(t *testing.T) {
	for _, mode := range []string{"eof", "client_write_failure"} {
		t.Run(mode, func(t *testing.T) {
			f := setup(t, 1)
			in := f.input(t)
			gateway := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				if _, err := f.core.Admit(r.Context(), f.gate, in); err != nil {
					t.Error(err)
					w.WriteHeader(503)
					return
				}
				w.Header().Set("Content-Type", "text/event-stream")
				io.WriteString(w, "data: {\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":7,\"total_tokens\":19,\"prompt_tokens_details\":{\"cached_tokens\":4},\"completion_tokens_details\":{\"reasoning_tokens\":3}}}\n\n")
				w.(http.Flusher).Flush()
			}))
			defer gateway.Close()
			relay := &Relay{core: f.core, endpoint: gateway.URL, client: gateway.Client(), maxBytes: 1 << 20, maxLine: 65536}
			var writer http.ResponseWriter = httptest.NewRecorder()
			if mode == "client_write_failure" {
				writer = &cancelWriter{header: http.Header{}}
			}
			err := relay.Forward(context.Background(), writer, RelayCall{Input: in, Body: []byte(`{"model":"synthetic","messages":[{"role":"user","content":"test"}]}`), Ticket: "qa-fixture", PlanHeader: "qa-fixture", Stream: true})
			if err == nil {
				t.Fatal("incomplete transport reported success")
			}
			var raw []byte
			if err := f.db.QueryRow("SELECT event_json FROM usage_events WHERE request_id=?", in.RequestID).Scan(&raw); err != nil {
				t.Fatal(err)
			}
			var event map[string]any
			if err := json.Unmarshal(raw, &event); err != nil {
				t.Fatal(err)
			}
			t.Logf("request_id=%s terminal_usage=%s", in.RequestID, rawUsage(event))
			usage := event["usage"].(map[string]any)
			if usage["total_tokens"] != float64(19) {
				t.Errorf("QA-001: received validated usage discarded: got=%v want=19", usage["total_tokens"])
			}
			// A complete usage frame alone is NOT refund authority.
			// QA-001 asks architecture to preserve/classify observed usage;
			// it does not require financial held to be released.
			t.Logf("financial_counter=%+v (final authority pending)", readCounter(t, f, "tokens"))
		})
	}
}

func rawUsage(event map[string]any) string { b, _ := json.Marshal(event["usage"]); return string(b) }

func TestQADeadlineAfterHeaders(t *testing.T) {
	f := setup(t, 1)
	in := f.input(t)
	in.Expires = time.Now().UTC().Add(250 * time.Millisecond)
	in.Deadline = time.Now().UTC().Add(500 * time.Millisecond)
	gateway := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if _, err := f.core.Admit(r.Context(), f.gate, in); err != nil {
			t.Error(err)
			w.WriteHeader(503)
			return
		}
		fmt.Fprint(w, "data: {\"choices\":[{\"delta\":{\"content\":\"test\"}}]}\n\n")
		w.(http.Flusher).Flush()
		<-r.Context().Done()
	}))
	defer gateway.Close()
	relay := &Relay{core: f.core, endpoint: gateway.URL, client: gateway.Client(), maxBytes: 1 << 20, maxLine: 65536}
	recorder := httptest.NewRecorder()
	if err := relay.Forward(context.Background(), recorder, RelayCall{Input: in, Body: []byte(`{"model":"synthetic"}`), Stream: true}); err == nil {
		t.Fatal("deadline reported success")
	}
	_, state, err := f.core.ReadRequest(context.Background(), in.RequestID)
	if err != nil {
		t.Fatal(err)
	}
	t.Logf("request_id=%s terminal=%s", in.RequestID, state)
	if state != "timed_out" {
		t.Errorf("QA-002: deadline after headers got=%s want=timed_out", state)
	}
}
