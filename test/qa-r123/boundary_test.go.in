package kernel

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"github.com/google/uuid"
	"github.com/jianzi123/maas/internal/protocol"
	"io"
	"net/http"
	"net/http/httptest"
	"os"
	"strings"
	"testing"
	"time"
)

type qaRWriter struct {
	*httptest.ResponseRecorder
	mode      string
	cancel    context.CancelFunc
	ctx       context.Context
	f         *fixture
	id        string
	committed []byte
	t         *testing.T
}

func (w *qaRWriter) WriteString(s string) (int, error) { return w.Write([]byte(s)) }
func (w *qaRWriter) Write(b []byte) (int, error) {
	n, e := w.ResponseRecorder.Write(b)
	if strings.Contains(string(b), `"finish_reason":"stop"`) {
		if w.mode == "cancel_finish" {
			w.cancel()
		}
		if w.mode == "deadline_finish" {
			<-w.ctx.Done()
		}
	}
	if strings.Contains(string(b), `"usage":`) && w.mode == "cancel_committed" {
		if e := w.f.db.QueryRow("SELECT event_json FROM usage_events WHERE request_id=?", w.id).Scan(&w.committed); e != nil {
			w.t.Fatal("cancel not at committed boundary", e)
		}
		w.cancel()
	}
	return n, e
}
func qaRCheck(t *testing.T, f *fixture, id string, unknown bool) map[string]any {
	t.Helper()
	var raw []byte
	if e := f.db.QueryRow("SELECT event_json FROM usage_events WHERE request_id=?", id).Scan(&raw); e != nil {
		t.Fatal(e)
	}
	var event map[string]any
	json.Unmarshal(raw, &event)
	if e := protocol.Validate("Terminal", event); e != nil {
		t.Fatal(e)
	}
	assertSQL(t, f.db, "SELECT COUNT(*) FROM usage_events", 1)
	assertSQL(t, f.db, "SELECT SUM(finalized_total) FROM usage_daily", 1)
	assertSQL(t, f.db, "SELECT COUNT(*) FROM concurrency_slots WHERE state='QUARANTINED'", 1)
	tok, mon := readCounter(t, f, "tokens"), readCounter(t, f, "money")
	if unknown {
		for _, k := range []string{"input_tokens", "output_tokens", "total_tokens", "input_cached_tokens", "reasoning_tokens"} {
			if event["usage"].(map[string]any)[k] != nil {
				t.Error("unknown usage fabricated", k)
			}
		}
		a := event["budget_accounting"].(map[string]any)
		if a["token_actual"] != nil || a["cost_actual_atomic"] != nil {
			t.Error("unknown accounting actual")
		}
		if tok != (Counter{Known: "0", Reserved: "0", Held: "140"}) || mon != (Counter{Known: "0", Reserved: "0", Held: "520000"}) {
			t.Error("unknown held changed", tok, mon)
		}
	} else {
		if tok.Known != "19" || mon.Known != "72800" || tok.Held != "0" || mon.Held != "0" {
			t.Error("committed finance changed", tok, mon)
		}
	}
	if e := f.core.Release(context.Background(), id, uuid.NewString(), uuid.NewString()); e != nil {
		t.Fatal(e)
	}
	if readCounter(t, f, "tokens") != tok || readCounter(t, f, "money") != mon {
		t.Error("slot changed finance")
	}
	var after []byte
	f.db.QueryRow("SELECT event_json FROM usage_events WHERE request_id=?", id).Scan(&after)
	if string(after) != string(raw) {
		t.Error("slot rewrote terminal")
	}
	return event
}
func TestQAR1R2(t *testing.T) {
	evidence := []map[string]any{}
	for _, mode := range []string{"normal", "cancel_finish", "deadline_finish", "cancel_committed", "content_after_finish", "contradictory_finish", "independent_final"} {
		t.Run(mode, func(t *testing.T) {
			f := setupUsagePolicy(t, 1, &UsagePolicy{"qa-r123-controlled", "final_only"})
			in := f.input(t)
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			if mode == "deadline_finish" {
				var done context.CancelFunc
				ctx, done = context.WithTimeout(ctx, 5*time.Second)
				defer done()
			}
			calls := 0
			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				calls++
				io.Copy(io.Discard, r.Body)
				if _, e := f.core.Admit(r.Context(), f.gate, in); e != nil {
					t.Error(e)
					w.WriteHeader(503)
					return
				}
				io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"content\":\"BEFORE_FINISH\"}}]}\n\n")
				if mode != "independent_final" {
					io.WriteString(w, diagnosticFrame)
				}
				io.WriteString(w, "data: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n")
				if mode == "content_after_finish" {
					io.WriteString(w, "data: {\"choices\":[{\"delta\":{\"content\":\"AFTER_FINISH\"}}]}\n\n")
				}
				if mode == "contradictory_finish" {
					io.WriteString(w, "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"length\"}]}\n\n")
				}
				if mode == "independent_final" {
					io.WriteString(w, diagnosticFrame)
				}
				io.WriteString(w, "data: [DONE]\n\n")
			}))
			defer srv.Close()
			w := &qaRWriter{ResponseRecorder: httptest.NewRecorder(), mode: mode, cancel: cancel, ctx: ctx, f: f, id: in.RequestID, t: t}
			relay := &Relay{core: f.core, endpoint: srv.URL, client: srv.Client(), maxBytes: 65536, maxLine: 65536}
			err := relay.Forward(ctx, w, RelayCall{Input: in, Body: []byte(`{"model":"synthetic"}`), Stream: true})
			unknown := mode != "normal" && mode != "independent_final" && mode != "cancel_committed"
			event := qaRCheck(t, f, in.RequestID, unknown)
			if calls != 1 {
				t.Error("replayed upstream")
			}
			if unknown || mode == "cancel_committed" {
				if err == nil || strings.Contains(w.Body.String(), "[DONE]") {
					t.Error("stopped stream completed normally")
				}
			} else if err != nil || strings.Count(w.Body.String(), "[DONE]") != 1 {
				t.Error("normal control", err)
			}
			if mode == "cancel_finish" && event["result"] != "cancelled" {
				t.Error("cancel lost")
			}
			if mode == "deadline_finish" && event["result"] != "timed_out" {
				t.Error("deadline lost")
			}
			if mode == "content_after_finish" || mode == "contradictory_finish" {
				if event["result"] != "failed" || strings.Contains(w.Body.String(), "AFTER_FINISH") {
					t.Error("finish not sealed")
				}
			}
			if mode == "cancel_committed" {
				var raw []byte
				f.db.QueryRow("SELECT event_json FROM usage_events WHERE request_id=?", in.RequestID).Scan(&raw)
				if len(w.committed) == 0 || string(raw) != string(w.committed) || event["result"] != "succeeded" {
					t.Error("postcommit cancellation reopened accounting")
				}
			}
			rows, e := f.core.ReadDiagnostics(context.Background(), in.RequestID)
			if e != nil {
				t.Fatal(e)
			}
			evidence = append(evidence, map[string]any{"case": mode, "request_id": in.RequestID, "terminal": event, "diagnostics": rows, "calls": calls, "passed": !t.Failed()})
			t.Logf("request_id=%s mode=%s result=%v unknown=%v", in.RequestID, mode, event["result"], unknown)
		})
	}
	if p := os.Getenv("MAAS_QA_R123_EVIDENCE"); p != "" {
		b, _ := json.MarshalIndent(evidence, "", "  ")
		if e := os.WriteFile(p, b, 0600); e != nil {
			t.Fatal(e)
		}
	}
}
func TestQAR1TransactionRollback(t *testing.T) {
	for _, cause := range []string{"cancel", "deadline"} {
		t.Run(cause, func(t *testing.T) {
			f := setup(t, 1)
			snap := mustAdmit(t, f, f.input(t))
			fin := finalFor(snap)
			fin.Result = "succeeded"
			fin.Submitted = true
			i, o, total, c, r := int64(12), int64(7), int64(19), int64(4), int64(3)
			fin.Usage = Usage{Input: &i, Output: &o, Total: &total, Cached: &c, Reasoning: &r, Source: "upstream"}
			target := context.Canceled
			if cause == "deadline" {
				target = context.DeadlineExceeded
			}
			err := f.core.finalizeChecked(context.Background(), fin, func(tx *sql.Tx) error {
				var n int
				if e := tx.QueryRow("SELECT COUNT(*) FROM usage_events WHERE request_id=?", fin.RequestID).Scan(&n); e != nil || n != 1 {
					t.Fatal("real write set missing", e, n)
				}
				if e := tx.QueryRow("SELECT SUM(finalized_total) FROM usage_daily").Scan(&n); e != nil || n != 1 {
					t.Fatal("summary write set missing", e, n)
				}
				return target
			})
			if !errors.Is(err, target) {
				t.Fatal(err)
			}
			assertSQL(t, f.db, "SELECT COUNT(*) FROM usage_events", 0)
			assertSQL(t, f.db, "SELECT COUNT(*) FROM usage_daily", 0)
			if readCounter(t, f, "tokens") != (Counter{Known: "0", Reserved: "140", Held: "0"}) || readCounter(t, f, "money") != (Counter{Known: "0", Reserved: "520000", Held: "0"}) {
				t.Fatal("partial finance committed")
			}
			_, state, e := f.core.ReadRequest(context.Background(), fin.RequestID)
			if e != nil || state != "in_progress" {
				t.Fatal("request changed after rollback", e, state)
			}
			fin.Result = "cancelled"
			if cause == "deadline" {
				fin.Result = "timed_out"
			}
			fin.Submitted = false
			fin.Usage = unavailableUsage("not_provided")
			if e := f.core.Finalize(context.Background(), fin); e != nil {
				t.Fatal(e)
			}
			qaRCheck(t, f, fin.RequestID, true)
			t.Logf("request_id=%s cause=%s real_full_writes_rolled_back=true unique_exception=true", fin.RequestID, cause)
		})
	}
}
